<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Shell1448.App</RootNamespace>
    <AssemblyName>Shell1448</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Собирается ТОЛЬКО на Windows. Флаги single-file/self-contained
         задаются в команде publish, см. shell/README.md -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shell1448.Shared\Shell1448.Shared.csproj" />
  </ItemGroup>

</Project>
