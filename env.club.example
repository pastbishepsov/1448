# .env.club — переменные клубной установки (ПК-1).
# Скопируй в .env.club и заполни. НЕ коммитить .env.club в git!
# Секреты генерь в Git Bash:  openssl rand -hex 24

POSTGRES_USER=club1448
POSTGRES_PASSWORD=ЗАМЕНИ_openssl_rand_hex_24
POSTGRES_DB=1448_db
JWT_SECRET=ЗАМЕНИ_openssl_rand_hex_32

# 8090 — для прогона дома рядом с dev-стеком; в клубе поставь 8080
PUBLISH_PORT=8080

# Часовой пояс — Europe/Warsaw, задавать ничего не нужно (З2-и1). Сервер сам
# ставит его соединению с базой: Postgres в контейнере живёт в UTC, и без этого
# отчёты теряли утро из графика дня, а пик по часам съезжал на 2 часа. Если в
# строке подключения окажется другой пояс (timezone=… / TimeZone=…), сервер не
# стартует и скажет, что поправить.

# Кому верить про адрес клиента (К0-и5). В клубе ПК ходят к серверу напрямую —
# оставь пустым: X-Forwarded-For от самого клиента тогда не обходит лимитер.
# На стенде за реальным прокси (Railway) задай его сети или 0.0.0.0/0,::/0.
TRUSTED_PROXIES=

# Токен агента (К4-и3). Один секрет на клуб: сюда — и тот же в agent.json
# ("token"), appsettings.json (Shell:AgentToken) и shell.json ("agent_token")
# на каждом ПК. Без него /ws/shell пускает любого, кто знает UUID компьютера,
# а публичный /catalog отдаёт пути к играм на диске. Порядок обновления:
# сначала раздать токен по ПК, потом задать здесь (пустой = проверка выключена).
# Сгенерировать: openssl rand -hex 32
AGENT_TOKEN=
