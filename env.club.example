# .env.club — переменные клубной установки (ПК-1).
# Скопируй в .env.club и заполни. НЕ коммитить .env.club в git!
# Секреты генерь в Git Bash:  openssl rand -hex 24

POSTGRES_USER=club1448
POSTGRES_PASSWORD=ЗАМЕНИ_openssl_rand_hex_24
POSTGRES_DB=1448_db
JWT_SECRET=ЗАМЕНИ_openssl_rand_hex_32

# 8090 — для прогона дома рядом с dev-стеком; в клубе поставь 8080
PUBLISH_PORT=8080

# Кому верить про адрес клиента (К0-и5). В клубе ПК ходят к серверу напрямую —
# оставь пустым: X-Forwarded-For от самого клиента тогда не обходит лимитер.
# На стенде за реальным прокси (Railway) задай его сети или 0.0.0.0/0,::/0.
TRUSTED_PROXIES=
